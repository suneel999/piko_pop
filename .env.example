# PIKO POP environment
# Copy to .env and fill in values. Never commit .env to git.

# local | staging | production
APP_ENV=production

# Database (required on staging/production servers)
DB_HOST=localhost
DB_DATABASE=pakodi_and_politics
DB_USERNAME=root
DB_PASSWORD=

# Razorpay Live Checkout (real payments)
# Dashboard: dashboard.razorpay.com → Settings → API Keys → Live Mode
# Key ID must start with rzp_live_
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret

# Webhook secret (Settings → Webhooks → create webhook → copy secret)
# Webhook URL: https://yourdomain.com/webhook/razorpay
# Events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# OTP — disable bypass in production (configure real SMS)
OTP_BYPASS=false
OTP_BYPASS_CODE=123456
