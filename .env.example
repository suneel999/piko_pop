# PIKO POP environment
# Copy to .env and fill in values. Never commit .env to git.

# local | staging | production
APP_ENV=local

# Database (required on staging/production servers)
DB_HOST=localhost
DB_DATABASE=pakodi_and_politics
DB_USERNAME=root
DB_PASSWORD=

# Razorpay Standard Checkout (required for payments)
# Test keys: dashboard.razorpay.com → Settings → API Keys → Test Mode
# Live keys: switch to Live Mode after KYC activation
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# OTP test bypass — set true on staging only while SMS is not configured
OTP_BYPASS=false
OTP_BYPASS_CODE=123456
