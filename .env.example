# PIKO POP environment
# Copy to .env and fill in values. Never commit .env to git.

# local | staging | production
APP_ENV=local

# AWS: use APP_ENV=staging on staging server, production on prod server

# Optional override (auto-detected from HTTP_HOST if empty)
# APP_URL=http://localhost/piko_pop/

# Database (required on staging/production servers)
DB_HOST=localhost
DB_DATABASE=pakodi_and_politics
DB_USERNAME=root
DB_PASSWORD=

# Razorpay (optional overrides; app config has defaults)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
